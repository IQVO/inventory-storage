{"parameters":[{"name":"from","in":"query","required":true,"description":"Inclusive start of the window, RFC 3339.","schema":{"type":"string","format":"date-time","example":"2026-10-01T00:00:00Z"}},{"name":"to","in":"query","required":true,"description":"End of the window, RFC 3339.","schema":{"type":"string","format":"date-time","example":"2026-10-02T00:00:00Z"}},{"name":"sku","in":"query","required":false,"description":"Restrict to one SKU.","schema":{"type":"string","example":"SKU-1"}},{"name":"binId","in":"query","required":false,"description":"Restrict to one bin.","schema":{"type":"string","example":"A-1-1"}},{"name":"granularity","in":"query","required":false,"description":"Bucket size. Only `hour` is supported (the default).","schema":{"type":"string","enum":["hour"],"default":"hour"}}]}